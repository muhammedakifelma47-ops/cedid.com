---
import { Image } from "astro:assets";
import Logo from "./Logo.astro";
import Icon from "./Icon.astro";
import { companyInfo, navigationItems, legalLinks } from "../data/site";
import { categories, categoryHref } from "../data/catalog";
import { getScene } from "../lib/images";

const year = new Date().getFullYear();
---

<footer class="relative overflow-hidden bg-navy-deep text-white/80">
  <!-- Sağ tarafta soluk lojistik görseli ve marka şeritleri -->
  <div class="pointer-events-none absolute inset-y-0 right-0 hidden w-[42%] lg:block" aria-hidden="true">
    <Image
      src={getScene("kamyon")}
      alt=""
      widths={[600, 900]}
      sizes="42vw"
      class="h-full w-full object-cover opacity-[0.16] grayscale"
      loading="lazy"
    />
    <div class="absolute inset-0 bg-gradient-to-r from-navy-deep via-navy-deep/70 to-navy-deep/10"></div>
    <svg class="absolute -right-10 -top-8 h-40 w-[520px]" viewBox="0 0 520 160" preserveAspectRatio="none">
      <path d="M520 0H120c120 40 260 60 400 60z" fill="#800020" opacity="0.85"></path>
      <path d="M520 60c-140 0-280-18-400-60h-60c140 70 300 100 460 100z" fill="#000080" opacity="0.55"></path>
    </svg>
  </div>

  <div class="container-site relative grid gap-10 py-14 sm:grid-cols-2 lg:grid-cols-[1.35fr_1fr_1.1fr_1.2fr] lg:gap-12 lg:py-16">
    <div class="max-w-sm">
      <a href="/" class="inline-flex h-14" aria-label="Cedid Ambalaj ana sayfa">
        <Logo variant="light" class="h-full" />
      </a>
      <p class="mt-5 text-[12px] font-bold uppercase tracking-[0.22em] text-white">{companyInfo.slogan}</p>
      <p class="mt-3 text-[14px] leading-relaxed">{companyInfo.shortDescription}</p>
      <a
        href={companyInfo.instagram.url}
        target="_blank"
        rel="noopener noreferrer"
        class="mt-5 inline-flex items-center gap-3 text-[14px] text-white transition-colors hover:text-white/80"
      >
        <span class="grid size-10 place-items-center rounded-full border border-white/35">
          <Icon name="instagram" size={18} />
        </span>
        {companyInfo.instagram.username}
        <span class="sr-only">(Instagram, yeni sekmede açılır)</span>
      </a>
    </div>

    <nav aria-labelledby="footer-hizli">
      <h2 id="footer-hizli" class="text-[15px] font-bold text-white">Hızlı Bağlantılar</h2>
      <ul class="mt-4 space-y-2.5 text-[14px]">
        {
          navigationItems.map((item) => (
            <li>
              <a href={item.href} class="transition-colors hover:text-white">
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <nav aria-labelledby="footer-urun">
      <h2 id="footer-urun" class="text-[15px] font-bold text-white">Ürün Grupları</h2>
      <ul class="mt-4 space-y-2.5 text-[14px]">
        {
          categories.map((category) => (
            <li>
              <a href={categoryHref(category.slug)} class="transition-colors hover:text-white">
                {category.name}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div>
      <h2 class="text-[15px] font-bold text-white">İletişim</h2>
      <ul class="mt-4 space-y-3 text-[14px]">
        {
          companyInfo.phones.map((phone) => (
            <li>
              <a href={phone.href} class="inline-flex items-center gap-3 transition-colors hover:text-white">
                <Icon name="phone" size={17} class="text-white" />
                {phone.display}
              </a>
            </li>
          ))
        }
        <li>
          <a href={`mailto:${companyInfo.email}`} class="inline-flex items-center gap-3 transition-colors hover:text-white">
            <Icon name="mail" size={17} class="text-white" />
            {companyInfo.email}
          </a>
        </li>
        {
          companyInfo.address && (
            <li class="inline-flex items-start gap-3">
              <Icon name="home" size={17} class="mt-0.5 text-white" />
              {companyInfo.address}
            </li>
          )
        }
      </ul>
    </div>
  </div>

  <div class="relative border-t border-white/10">
    <div class="container-site flex flex-col gap-3 py-5 text-[13px] text-white/60 sm:flex-row sm:items-center sm:justify-between">
      <p>© {year} {companyInfo.legalName} Tüm hakları saklıdır.</p>
      <ul class="flex flex-wrap gap-x-5 gap-y-1">
        {
          legalLinks.map((link) => (
            <li>
              <a href={link.href} class="transition-colors hover:text-white">
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</footer>
