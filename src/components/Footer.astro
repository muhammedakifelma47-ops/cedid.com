---
import { Image } from "astro:assets";
import Logo from "./Logo.astro";
import Icon from "./Icon.astro";
import { companyInfo, navigationItems, legalLinks } from "../data/site";
import { categories, categoryHref } from "../data/catalog";
import { getScene } from "../lib/images";

const year = new Date().getFullYear();
const companyDescription = "Ambalaj, temizlik, gıda ve ofis sarf malzemelerinde işletmenizin güvenilir tedarik çözümü.";
const companyAddress = "Yakuplu, 78. Sk. 15 B, 34524 Beylikdüzü OSB/Beylikdüzü/İstanbul";
const mapsUrl = "https://www.google.com/maps/place//data=!4m2!3m1!1s0x14b55f137bf62471:0x2080632eead06a7a?sa=X&ved=1t:8290&ictx=111";
const mapsEmbedUrl = "https://www.google.com/maps/embed?origin=mfe&pb=!1m3!2m1!1sYakuplu,+78.+Sk.+15+B,+34524+Beylikdüzü+OSB/Beylikdüzü/İstanbul!6i14";
const quickLinks = navigationItems.filter(({ href }) => ["/", "/hakkimizda", "/e-katalog", "/iletisim"].includes(href));
---

<footer id="site-footer" class="cedid-footer relative isolate overflow-hidden bg-[#061a35] text-white/85">
  <div class="pointer-events-none absolute inset-0 z-0" aria-hidden="true">
    <Image
      src={getScene("kamyon")}
      alt=""
      widths={[900, 1280, 1920]}
      sizes="100vw"
      class="absolute inset-0 h-full w-full object-cover object-center opacity-45"
      loading="lazy"
    />
    <div class="footer-overlay absolute inset-0"></div>
    <div class="footer-ribbon absolute -right-10 -top-14 h-28 w-[38%] -rotate-3 bg-[#800020]" aria-hidden="true"></div>
    <div class="footer-ribbon absolute -right-12 -top-20 h-32 w-[40%] -rotate-3 bg-[#000080]" aria-hidden="true"></div>
  </div>

  <div class="footer-content">
    <section aria-label="Cedid Ambalaj">
      <a href="/" class="inline-flex w-fit items-center" aria-label="Cedid Ambalaj ana sayfa">
        <Logo variant="light" class="w-[155px] max-w-full justify-center rounded-md px-2.5 py-1.5 [&>img]:h-auto [&>img]:w-full" />
      </a>
      <span class="mt-3 block h-1 w-14 rounded-full bg-[#800020]" aria-hidden="true"></span>
      <p class="mt-2 text-[15px] font-bold uppercase tracking-[0.12em] text-white">İşletmenizin Tedarik Gücü</p>
      <p class="mt-3 max-w-[340px] text-[15px] leading-relaxed text-white/85">{companyDescription}</p>
      <a
        href={companyInfo.instagram.url}
        target="_blank"
        rel="noopener noreferrer"
        class="mt-6 inline-flex min-h-14 items-center gap-3 text-[17px] font-semibold text-white transition-opacity hover:opacity-80"
        aria-label="Instagram hesabı @cedidambalaj, yeni sekmede açılır"
      >
        <span class="grid size-14 place-items-center rounded-[15px] bg-gradient-to-br from-[#7545dc] via-[#e1306c] to-[#ffb347] shadow-lg">
          <Icon name="instagram" size={34} class="text-white" strokeWidth={2.1} />
        </span>
        <span>{companyInfo.instagram.username}</span>
      </a>
    </section>

    <nav aria-labelledby="footer-hizli">
      <h2 id="footer-hizli" class="footer-heading">Hızlı Bağlantılar</h2>
      <span class="footer-heading-rule" aria-hidden="true"></span>
      <ul class="mt-4 space-y-1 text-[15px]">
        {quickLinks.map((item) => (
          <li>
            <a href={item.href} class="footer-link"><Icon name="chevron-right" size={21} />{item.label}</a>
          </li>
        ))}
      </ul>
    </nav>

    <nav aria-labelledby="footer-urun">
      <h2 id="footer-urun" class="footer-heading">Ürün Grupları</h2>
      <span class="footer-heading-rule" aria-hidden="true"></span>
      <ul class="mt-4 space-y-1 text-[15px]">
        {categories.map((category) => (
          <li>
            <a href={categoryHref(category.slug)} class="footer-link"><Icon name="chevron-right" size={21} />{category.name}</a>
          </li>
        ))}
      </ul>
    </nav>

    <section aria-labelledby="footer-iletisim">
      <h2 id="footer-iletisim" class="footer-heading">İletişim</h2>
      <span class="footer-heading-rule" aria-hidden="true"></span>
      <ul class="mt-4 space-y-1 text-[15px]">
        {companyInfo.phones.map((phone) => (
          <li>
            <a href={phone.href} class="footer-contact-link">
              <span class="footer-contact-icon"><Icon name="phone" size={22} /></span>
              <span>{phone.display}</span>
            </a>
          </li>
        ))}
        <li>
          <a href={`mailto:${companyInfo.email}`} class="footer-contact-link">
            <span class="footer-contact-icon"><Icon name="mail" size={22} /></span>
            <span>{companyInfo.email}</span>
          </a>
        </li>
        <li>
          <a href={mapsUrl} target="_blank" rel="noopener noreferrer" class="footer-contact-link items-start">
            <span class="footer-contact-icon mt-0.5"><Icon name="map-pin" size={22} /></span>
            <span>{companyAddress}</span>
          </a>
        </li>
      </ul>
    </section>

    <section aria-labelledby="footer-konum">
      <h2 id="footer-konum" class="footer-heading mb-4">Konum</h2>
      <div class="overflow-hidden rounded-xl border border-white/70 bg-[#0a2444] shadow-xl">
        <iframe
          src={mapsEmbedUrl}
          title="Cedid Ambalaj, Yakuplu Beylikdüzü konumu"
          loading="lazy"
          allowfullscreen
          referrerpolicy="strict-origin-when-cross-origin"
          class="block h-[150px] w-full border-0"
        ></iframe>
        <a
          href={mapsUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="flex min-h-[56px] items-center justify-center gap-3 bg-[#061a35]/95 px-4 text-[16px] font-bold text-white transition-colors hover:bg-[#800020]"
          aria-label={`Google Maps'te konumu görüntüle: ${companyAddress}`}
        >
          <Icon name="map-pin" size={21} />
          <span>Haritada Görüntüle</span>
          <Icon name="arrow-right" size={20} />
        </a>
      </div>
    </section>
  </div>

  <div class="relative z-10 border-t border-white/25 bg-[#041831]/50">
    <div class="mx-auto flex w-full max-w-[1400px] flex-col gap-4 px-6 py-5 text-[15px] text-white/85 sm:flex-row sm:items-center sm:justify-between sm:px-8">
      <p>© {year} Cedid Ambalaj Tic. Ltd. Şti. Tüm hakları saklıdır.</p>
      <ul class="flex flex-wrap gap-x-5 gap-y-2">
        {legalLinks.map((link) => (
          <li><a href={link.href} class="inline-flex items-center gap-3 transition-colors hover:text-white">{link.label}<Icon name="chevron-right" size={19} /></a></li>
        ))}
      </ul>
    </div>
  </div>
</footer>

<style>
  .cedid-footer::before {
    position: absolute;
    z-index: 1;
    inset: 0 0 auto;
    height: 5px;
    background: linear-gradient(90deg, #800020, #000080 45%, #800020);
    content: "";
  }

  .footer-overlay {
    background: linear-gradient(90deg, rgb(3 24 49 / 91%) 0%, rgb(3 24 49 / 88%) 48%, rgb(3 24 49 / 72%) 100%);
  }

  .footer-content {
    position: relative;
    z-index: 10;
    display: grid;
    width: 100%;
    max-width: 1400px;
    margin-inline: auto;
    padding: 48px 24px;
    grid-template-columns: minmax(0, 1fr);
    align-items: start;
    column-gap: 24px;
    row-gap: 40px;
  }

  .footer-content > * {
    position: static;
    width: auto;
    max-width: none;
    min-width: 0;
    grid-column: auto;
    grid-row: auto;
    order: 0;
  }

  @media (min-width: 640px) {
    .footer-content {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      padding-inline: 32px;
    }
  }

  @media (min-width: 1024px) {
    .footer-content {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (min-width: 1200px) {
    .footer-content {
      grid-template-columns: 1.2fr 0.9fr 1fr 1.3fr 1.2fr;
      align-items: start;
    }
  }

  .footer-heading {
    color: #fff;
    font-size: 18px;
    font-weight: 700;
    line-height: 1.25;
  }

  .footer-heading-rule {
    display: block;
    width: 66px;
    height: 5px;
    margin-top: 12px;
    border-radius: 999px;
    background: #a80032;
  }

  .footer-link {
    display: inline-flex;
    min-height: 34px;
    align-items: center;
    gap: 10px;
    color: rgb(255 255 255 / 87%);
    transition: color 160ms ease;
  }

  .footer-link:hover,
  .footer-link:focus-visible {
    color: #fff;
  }

  .footer-contact-link {
    display: flex;
    min-height: 40px;
    align-items: center;
    gap: 10px;
    color: rgb(255 255 255 / 90%);
    line-height: 1.55;
    overflow-wrap: anywhere;
    transition: color 160ms ease;
  }

  .footer-contact-link:hover,
  .footer-contact-link:focus-visible {
    color: #fff;
  }

  .footer-contact-icon {
    display: grid;
    width: 38px;
    height: 38px;
    flex: 0 0 38px;
    place-items: center;
    border-radius: 999px;
    background: #a00030;
    color: #fff;
  }

  @media (max-width: 639px) {
    .footer-ribbon {
      width: 72%;
    }
  }
</style>
