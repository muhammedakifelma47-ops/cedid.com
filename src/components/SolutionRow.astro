---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import Icon from "./Icon.astro";
import type { Product } from "../data/catalog";
import { productHref } from "../data/catalog";

interface Props {
  id: string;
  index: number;
  title: string;
  description: string;
  image: ImageMetadata | string;
  imageAlt: string;
  products: Product[];
  link: { href: string; label: string };
  reverse?: boolean;
}

const { id, index, title, description, image, imageAlt, products, link, reverse = false } = Astro.props;
---

<section id={id} class="scroll-mt-32 grid items-center gap-8 lg:grid-cols-2 lg:gap-14" aria-labelledby={`${id}-baslik`}>
  <div class:list={["relative aspect-[4/3] overflow-hidden rounded-md bg-light lg:aspect-[5/4]", reverse && "lg:order-2"]}>
    {typeof image === "string" ? (
      <img src={image} alt={imageAlt} loading="lazy" class="absolute inset-0 h-full w-full object-cover" />
    ) : (
      <Image
        src={image}
        alt={imageAlt}
        widths={[480, 720, 960]}
        sizes="(min-width: 1024px) 45vw, 100vw"
        class="absolute inset-0 h-full w-full object-cover"
      />
    )}
  </div>
  <div>
    <p class="text-[13px] font-bold uppercase tracking-[0.1em] text-bordo">{String(index).padStart(2, "0")}</p>
    <h2 id={`${id}-baslik`} class="mt-2 text-[26px] font-bold leading-tight lg:text-[32px]">{title}</h2>
    <span class="mt-4 block h-[3px] w-14 bg-bordo" aria-hidden="true"></span>
    <p class="mt-5 text-[16px] leading-relaxed text-muted">{description}</p>
    <ul class="mt-6 grid gap-x-6 gap-y-2.5 sm:grid-cols-2">
      {
        products.map((product) => (
          <li>
            <a href={productHref(product)} class="group inline-flex items-start gap-2 text-[15px] text-navy-deep hover:text-bordo">
              <Icon name="check-circle" size={18} class="mt-0.5 shrink-0 text-bordo" />
              <span class="group-hover:underline">{product.name}</span>
            </a>
          </li>
        ))
      }
    </ul>
    <a href={link.href} class="btn-navy mt-8">
      {link.label}
      <Icon name="arrow-right" size={17} />
    </a>
  </div>
</section>
