---
import Logo from "./Logo.astro";
import Icon from "./Icon.astro";
import { navigationItems, companyInfo } from "../data/site";
import { categories, categoryHref } from "../data/catalog";

const pathname = Astro.url.pathname.replace(/\/$/, "") || "/";

function isActive(href: string): boolean {
  if (href === "/") return pathname === "/";
  return pathname === href || pathname.startsWith(`${href}/`);
}
---

<header class="sticky top-0 z-50 border-b border-line bg-white shadow-[0_6px_18px_-14px_rgb(7_22_47/0.45)]" data-site-header>
  <div class="container-site flex h-[76px] items-center justify-between gap-6 lg:h-[92px]">
    <a href="/" class="flex h-11 shrink-0 items-center lg:h-[58px]" aria-label="Cedid Ambalaj ana sayfa">
      <Logo class="h-full" />
    </a>

    <nav aria-label="Ana menü" class="hidden h-full lg:block">
      <ul class="flex h-full items-center gap-0.5 xl:gap-2">
        {
          navigationItems.map((item) =>
            item.hasDropdown ? (
              <li class="relative flex h-full items-center" data-dropdown>
                <div class="flex items-center">
                  <a
                    href={item.href}
                    class:list={[
                      "nav-link relative py-2 pl-3 text-[14.5px] font-medium transition-colors hover:text-bordo",
                      isActive(item.href) ? "is-active text-bordo" : "text-ink",
                    ]}
                    aria-current={isActive(item.href) ? "page" : undefined}
                  >
                    {item.label}
                  </a>
                  <button
                    type="button"
                    class="ml-0.5 mr-1 grid size-7 place-items-center rounded text-ink transition-colors hover:text-bordo"
                    aria-expanded="false"
                    aria-controls="urun-menusu"
                    aria-label="Ürün kategorilerini göster"
                    data-dropdown-toggle
                  >
                    <Icon name="chevron-down" size={16} strokeWidth={2.25} class="transition-transform duration-200" />
                  </button>
                </div>
                <div
                  id="urun-menusu"
                  class="invisible absolute left-0 top-full w-[340px] translate-y-1 pt-1 opacity-0 transition-all duration-150"
                  data-dropdown-panel
                >
                  <ul class="overflow-hidden rounded-md border border-line bg-white py-2 shadow-panel">
                    {categories.map((category) => (
                      <li>
                        <a
                          href={categoryHref(category.slug)}
                          class:list={[
                            "flex items-start gap-3 px-4 py-3 transition-colors hover:bg-light focus-visible:bg-light",
                            isActive(categoryHref(category.slug)) && "bg-light",
                          ]}
                        >
                          <span class="mt-0.5 grid size-9 shrink-0 place-items-center rounded bg-light text-navy">
                            <Icon name={category.icon} size={20} />
                          </span>
                          <span>
                            <span class="block text-[15px] font-medium text-navy-deep">{category.name}</span>
                            <span class="mt-0.5 block text-[13px] leading-snug text-muted">{category.cardDescription}</span>
                          </span>
                        </a>
                      </li>
                    ))}
                    <li class="mt-1 border-t border-line px-4 pt-3 pb-1">
                      <a href="/urunlerimiz" class="link-arrow text-[14px]">
                        Tüm ürün gruplarını gör
                        <Icon name="arrow-right" size={16} />
                      </a>
                    </li>
                  </ul>
                </div>
              </li>
            ) : (
              <li class="flex h-full items-center">
                <a
                  href={item.href}
                  class:list={[
                    "nav-link relative px-3 py-2 text-[14.5px] font-medium transition-colors hover:text-bordo",
                    isActive(item.href) ? "is-active text-bordo" : "text-ink",
                  ]}
                  aria-current={isActive(item.href) ? "page" : undefined}
                >
                  {item.label}
                </a>
              </li>
            ),
          )
        }
      </ul>
    </nav>

    <div class="flex items-center gap-3">
      <a href="/urunlerimiz" class="btn-primary hidden px-5 xl:inline-flex">
        <Icon name="catalog" size={19} />
        Ürün Kataloğu
      </a>
      <button
        type="button"
        class="grid size-11 place-items-center rounded border border-line text-navy-deep lg:hidden"
        aria-expanded="false"
        aria-controls="mobil-menu"
        aria-label="Menüyü aç"
        data-mobile-toggle
      >
        <Icon name="menu" size={22} class="menu-open-icon" />
        <Icon name="x" size={22} class="menu-close-icon hidden" />
      </button>
    </div>
  </div>

  <div id="mobil-menu" class="hidden border-t border-line bg-white lg:hidden" data-mobile-menu>
    <nav aria-label="Mobil menü" class="container-site max-h-[calc(100svh-76px)] overflow-y-auto pb-6 pt-2">
      <ul class="divide-y divide-line">
        {
          navigationItems.map((item) =>
            item.hasDropdown ? (
              <li>
                <div class="flex items-center justify-between">
                  <a
                    href={item.href}
                    class:list={["block flex-1 py-3.5 text-[16px] font-medium", isActive(item.href) ? "text-bordo" : "text-ink"]}
                    aria-current={isActive(item.href) ? "page" : undefined}
                  >
                    {item.label}
                  </a>
                  <button
                    type="button"
                    class="grid size-11 place-items-center rounded text-navy-deep"
                    aria-expanded="false"
                    aria-controls="mobil-urun-menusu"
                    aria-label="Ürün kategorilerini göster"
                    data-mobile-sub-toggle
                  >
                    <Icon name="chevron-down" size={20} strokeWidth={2.25} class="transition-transform duration-200" />
                  </button>
                </div>
                <ul id="mobil-urun-menusu" class="hidden pb-3" data-mobile-sub>
                  {categories.map((category) => (
                    <li>
                      <a
                        href={categoryHref(category.slug)}
                        class="flex items-center gap-3 rounded px-3 py-2.5 text-[15px] text-ink hover:bg-light"
                      >
                        <Icon name={category.icon} size={18} class="text-navy" />
                        {category.name}
                      </a>
                    </li>
                  ))}
                </ul>
              </li>
            ) : (
              <li>
                <a
                  href={item.href}
                  class:list={["block py-3.5 text-[16px] font-medium", isActive(item.href) ? "text-bordo" : "text-ink"]}
                  aria-current={isActive(item.href) ? "page" : undefined}
                >
                  {item.label}
                </a>
              </li>
            ),
          )
        }
      </ul>
      <a href="/urunlerimiz" class="btn-primary mt-4 w-full">
        <Icon name="catalog" size={19} />
        Ürün Kataloğu
      </a>
      <div class="mt-5 grid gap-2 text-[14px] text-muted">
        {
          companyInfo.phones.map((phone) => (
            <a href={phone.href} class="inline-flex items-center gap-2">
              <Icon name="phone" size={16} class="text-navy" /> {phone.display}
            </a>
          ))
        }
        <a href={`mailto:${companyInfo.email}`} class="inline-flex items-center gap-2">
          <Icon name="mail" size={16} class="text-navy" /> {companyInfo.email}
        </a>
      </div>
    </nav>
  </div>
</header>

<style>
  .nav-link.is-active::after {
    content: "";
    position: absolute;
    left: 0.75rem;
    right: 0.75rem;
    bottom: -2px;
    height: 2px;
    background: var(--color-bordo);
  }

  [data-dropdown] .nav-link.is-active::after {
    right: 0;
  }

  [data-dropdown][data-open] [data-dropdown-panel] {
    visibility: visible;
    opacity: 1;
    transform: translateY(0);
  }

  [data-dropdown][data-open] [data-dropdown-toggle] :global(svg),
  [data-mobile-sub-toggle][aria-expanded="true"] :global(svg) {
    transform: rotate(180deg);
  }
</style>

<script>
  // Ürünlerimiz açılır menüsü: fareyle üzerine gelme, tıklama ve klavye desteği
  const dropdown = document.querySelector<HTMLElement>("[data-dropdown]");
  const toggle = dropdown?.querySelector<HTMLButtonElement>("[data-dropdown-toggle]");
  let closeTimer: number | undefined;

  function setOpen(open: boolean) {
    if (!dropdown || !toggle) return;
    window.clearTimeout(closeTimer);
    dropdown.toggleAttribute("data-open", open);
    toggle.setAttribute("aria-expanded", String(open));
  }

  if (dropdown && toggle) {
    const canHover = window.matchMedia("(hover: hover)").matches;

    toggle.addEventListener("click", (event) => {
      event.stopPropagation();
      setOpen(!dropdown.hasAttribute("data-open"));
    });

    if (canHover) {
      dropdown.addEventListener("mouseenter", () => setOpen(true));
      // Fare menü bağlantısından panele geçerken menünün kapanmaması için kısa gecikme
      dropdown.addEventListener("mouseleave", () => {
        closeTimer = window.setTimeout(() => setOpen(false), 180);
      });
    }

    dropdown.addEventListener("focusout", (event) => {
      const next = event.relatedTarget as Node | null;
      if (!next || !dropdown.contains(next)) setOpen(false);
    });

    dropdown.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && dropdown.hasAttribute("data-open")) {
        setOpen(false);
        toggle.focus();
      }
      if (event.key === "ArrowDown" && document.activeElement === toggle) {
        event.preventDefault();
        setOpen(true);
        dropdown.querySelector<HTMLAnchorElement>("[data-dropdown-panel] a")?.focus();
      }
    });

    document.addEventListener("click", (event) => {
      if (!dropdown.contains(event.target as Node)) setOpen(false);
    });
  }

  // Mobil menü
  const mobileToggle = document.querySelector<HTMLButtonElement>("[data-mobile-toggle]");
  const mobileMenu = document.querySelector<HTMLElement>("[data-mobile-menu]");

  function setMobileOpen(open: boolean) {
    if (!mobileToggle || !mobileMenu) return;
    mobileMenu.classList.toggle("hidden", !open);
    mobileToggle.setAttribute("aria-expanded", String(open));
    mobileToggle.setAttribute("aria-label", open ? "Menüyü kapat" : "Menüyü aç");
    mobileToggle.querySelector(".menu-open-icon")?.classList.toggle("hidden", open);
    mobileToggle.querySelector(".menu-close-icon")?.classList.toggle("hidden", !open);
  }

  mobileToggle?.addEventListener("click", () => {
    setMobileOpen(mobileToggle.getAttribute("aria-expanded") !== "true");
  });

  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape" && mobileToggle?.getAttribute("aria-expanded") === "true") {
      setMobileOpen(false);
      mobileToggle.focus();
    }
  });

  window.matchMedia("(min-width: 1024px)").addEventListener("change", (event) => {
    if (event.matches) setMobileOpen(false);
  });

  const subToggle = document.querySelector<HTMLButtonElement>("[data-mobile-sub-toggle]");
  const subMenu = document.querySelector<HTMLElement>("[data-mobile-sub]");
  subToggle?.addEventListener("click", () => {
    const open = subToggle.getAttribute("aria-expanded") !== "true";
    subToggle.setAttribute("aria-expanded", String(open));
    subMenu?.classList.toggle("hidden", !open);
  });
</script>
