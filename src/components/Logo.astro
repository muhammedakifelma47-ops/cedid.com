---
/**
 * Cedid Ambalaj orijinal logosu.
 *
 * Kaynak: public/images/logo/cedid-logo.jpeg (firma tarafından sağlanan dosya).
 * src/assets/images/brand/cedid-logo.png bu dosyanın yalnızca beyaz kenar boşlukları kırpılmış
 * hâlidir; logo yeniden çizilmez, renkleri ve oranı değiştirilmez.
 * Logonun zemini beyaz olduğu için koyu alanlarda ("light" varyantı) beyaz bir kart içinde gösterilir.
 */
import { Image } from "astro:assets";
import logo from "../assets/images/brand/cedid-logo.png";
import { companyInfo } from "../data/site";

interface Props {
  /** "light": koyu zemin (footer, lacivert paneller) için */
  variant?: "default" | "light";
  class?: string;
  /** Yalnızca ekranın üst kısmındaki logo için true */
  priority?: boolean;
}

const { variant = "default", class: className, priority = false } = Astro.props;
---

<span
  class:list={[
    "inline-flex items-center",
    variant === "light" && "rounded-md bg-white px-3 py-2 shadow-card",
    className,
  ]}
>
  <Image
    src={logo}
    alt={companyInfo.legalName}
    widths={[180, 270, 360, 540]}
    sizes="(min-width: 1024px) 170px, 130px"
    priority={priority}
    class="block h-full w-auto object-contain"
  />
</span>
