---
import { Image } from "astro:assets";
import Icon from "../Icon.astro";
import { getScene } from "../../lib/images";
---

<section class="relative isolate overflow-hidden bg-bordo" aria-labelledby="katalog-cta-baslik">
  <div class="grid lg:grid-cols-[40%_60%]">
    <div class="relative h-56 sm:h-64 lg:h-auto">
      <Image
        src={getScene("depo-koridor")}
        alt="Raflarında koliler bulunan geniş bir depo koridoru (temsili görsel)"
        widths={[640, 960, 1280]}
        sizes="(min-width: 1024px) 40vw, 100vw"
        class="absolute inset-0 h-full w-full object-cover"
      />
    </div>
    <div class="cta-panel relative bg-bordo px-4 py-12 sm:px-8 lg:py-14 lg:pr-56">
      <svg
        class="absolute inset-y-0 right-0 hidden h-full w-48 lg:block"
        viewBox="0 0 200 300"
        preserveAspectRatio="none"
        aria-hidden="true"
      >
        <path d="M200 0v300H120L200 0Z" fill="#07162F" opacity="0.9"></path>
        <path d="M200 0 120 300H92L182 0Z" fill="#000080" opacity="0.45"></path>
      </svg>
      <div class="relative flex max-w-[640px] flex-col gap-5 sm:flex-row sm:gap-7">
        <Icon name="file-text" size={54} strokeWidth={1.3} class="shrink-0 text-white" />
        <div>
          <h2 id="katalog-cta-baslik" class="text-[28px] font-bold leading-tight text-white lg:text-[32px]">
            Ürünlerimizi Keşfedin
          </h2>
          <p class="mt-3 text-[16px] leading-relaxed text-white/85">
            Cedid Ambalaj ürün gruplarını inceleyin ve işletmenizin ihtiyaçlarına uygun ürünleri keşfedin.
          </p>
          <a href="/urunlerimiz" class="btn-white mt-6">
            Ürün Kataloğunu Gör
            <Icon name="arrow-right" size={17} />
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  /* Referanstaki gibi görselle bordo panel arasında çapraz geçiş */
  @media (min-width: 1024px) {
    .cta-panel {
      margin-left: -9%;
      padding-left: 14%;
      clip-path: polygon(9% 0, 100% 0, 100% 100%, 0 100%);
    }
  }
</style>
