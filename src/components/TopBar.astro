---
import Icon from "./Icon.astro";
import { companyInfo } from "../data/site";
---

<div class="bg-navy-deep text-[12px] text-white/90 sm:text-[13px]">
  <div
    class="container-site flex min-h-10 flex-wrap items-center justify-center gap-x-5 gap-y-1 py-2 md:flex-nowrap md:justify-between md:py-0"
  >
    <p class="hidden font-medium tracking-wide md:block">{companyInfo.slogan}</p>
    <ul class="flex flex-wrap items-center justify-center gap-x-4 gap-y-1 lg:gap-x-6" aria-label="İletişim bilgileri">
      {
        companyInfo.phones.map((phone) => (
          <li>
            <a
              href={phone.href}
              class="inline-flex items-center gap-1.5 whitespace-nowrap transition-colors hover:text-white"
            >
              <Icon name="phone" size={14} class="text-white/70" />
              <span>{phone.display}</span>
            </a>
          </li>
        ))
      }
      <li>
        <a
          href={`mailto:${companyInfo.email}`}
          class="inline-flex items-center gap-1.5 whitespace-nowrap transition-colors hover:text-white"
        >
          <Icon name="mail" size={14} class="text-white/70" />
          <span>{companyInfo.email}</span>
        </a>
      </li>
    </ul>
  </div>
</div>
