---
import Icon from "./Icon.astro";
import { companyAdvantages } from "../data/site";
---

<section aria-label="Kurumsal avantajlarımız" class="border-b border-line bg-white">
  <ul class="container-site grid grid-cols-1 py-6 sm:grid-cols-2 lg:grid-cols-4 lg:py-10">
    {
      companyAdvantages.map((item, index) => (
        <li
          class:list={[
            "flex items-center gap-4 px-2 py-5 lg:justify-center lg:px-6 lg:py-2",
            index > 0 && "border-t border-line",
            index === 1 && "sm:border-t-0",
            index % 2 === 1 && "sm:border-l sm:pl-6",
            "lg:border-t-0",
            index > 0 && "lg:border-l",
          ]}
        >
          <Icon name={item.icon} size={46} strokeWidth={1.35} class="shrink-0 text-navy" />
          <span>
            <span class="block text-[19px] font-bold leading-tight text-bordo">{item.title}</span>
            <span class="mt-1 block text-[14px] text-ink/80">{item.description}</span>
          </span>
        </li>
      ))
    }
  </ul>
</section>
