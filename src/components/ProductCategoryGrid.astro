---
import { Image } from "astro:assets";
import Icon from "./Icon.astro";
import { categories, categoryHref } from "../data/catalog";
import { getCategoryImage } from "../lib/images";

interface Props {
  headingLevel?: "h2" | "h3";
}

const { headingLevel: Heading = "h3" } = Astro.props;
---

<ul class="grid gap-5 sm:grid-cols-2 lg:grid-cols-4 lg:gap-6">
  {
    categories.map((category) => {
      const isBordo = category.accent === "bordo";
      return (
        <li class="flex">
          <a
            href={categoryHref(category.slug)}
            class="group flex w-full flex-col overflow-hidden rounded-md bg-white shadow-card transition-shadow hover:shadow-panel"
          >
            <div class="relative aspect-[16/10] overflow-hidden bg-light">
              <Image
                src={getCategoryImage(category.slug)}
                alt={`${category.name} (temsili görsel)`}
                widths={[400, 640, 800]}
                sizes="(min-width: 1024px) 25vw, (min-width: 640px) 50vw, 100vw"
                class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-[1.04]"
              />
            </div>
            <div
              class:list={[
                "flex flex-1 items-center gap-4 px-5 py-5 text-white",
                isBordo ? "bg-bordo" : "bg-navy-deep",
              ]}
            >
              <div class="flex-1">
                <Heading class="text-[21px] font-bold leading-tight text-white">{category.name}</Heading>
                <p class="mt-1.5 text-[13.5px] leading-snug text-white/80">{category.cardDescription}</p>
              </div>
              <span
                class:list={[
                  "grid size-11 shrink-0 place-items-center rounded-full bg-white transition-transform duration-200 group-hover:translate-x-1",
                  isBordo ? "text-bordo" : "text-navy-deep",
                ]}
                aria-hidden="true"
              >
                <Icon name="arrow-right" size={20} strokeWidth={2.25} />
              </span>
            </div>
          </a>
        </li>
      );
    })
  }
</ul>
