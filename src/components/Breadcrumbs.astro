---
import Icon from "./Icon.astro";

export interface Crumb {
  label: string;
  href?: string;
}

interface Props {
  items: Crumb[];
}

const { items } = Astro.props;
const trail: Crumb[] = [{ label: "Ana Sayfa", href: "/" }, ...items];

const site = Astro.site ?? Astro.url;
const breadcrumbJsonLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: trail.map((crumb, index) => ({
    "@type": "ListItem",
    position: index + 1,
    name: crumb.label,
    item: new URL(crumb.href ?? Astro.url.pathname, site).href,
  })),
};
---

<div class="border-b border-line bg-light">
  <nav aria-label="Sayfa konumu" class="container-site overflow-x-auto py-3.5">
    <ol class="flex min-w-max items-center gap-2 text-[13.5px] text-muted">
      {
        trail.map((crumb, index) => {
          const isLast = index === trail.length - 1;
          return (
            <li class="flex items-center gap-2">
              {index === 0 && <Icon name="home" size={15} class="text-navy" />}
              {isLast || !crumb.href ? (
                <span aria-current={isLast ? "page" : undefined} class="font-medium text-navy-deep">
                  {crumb.label}
                </span>
              ) : (
                <a href={crumb.href} class="transition-colors hover:text-bordo">
                  {crumb.label}
                </a>
              )}
              {!isLast && <Icon name="chevron-right" size={14} class="text-muted/70" />}
            </li>
          );
        })
      }
    </ol>
  </nav>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd)} />
</div>
