---
import Icon from "./Icon.astro";
import { companyInfo } from "../data/site";

interface Props {
  title?: string;
  description?: string;
  /** E-posta konu satırı */
  emailSubject?: string;
  tone?: "navy" | "light";
}

const {
  title = "Bilgi almak için bize ulaşın",
  description = "Ürün grupları hakkında bilgi almak için telefon veya e-posta ile doğrudan iletişime geçebilirsiniz.",
  emailSubject,
  tone = "navy",
} = Astro.props;

const mailto = `mailto:${companyInfo.email}${emailSubject ? `?subject=${encodeURIComponent(emailSubject)}` : ""}`;
const dark = tone === "navy";
---

<section class:list={["rounded-md p-7 sm:p-9 lg:p-10", dark ? "bg-navy-deep text-white" : "border border-line bg-light"]}>
  <div class="flex flex-col gap-7 lg:flex-row lg:items-center lg:justify-between">
    <div class="max-w-[520px]">
      <h2 class:list={["text-[24px] font-bold leading-tight lg:text-[28px]", dark ? "text-white" : "text-navy-deep"]}>{title}</h2>
      <p class:list={["mt-2.5 text-[15px] leading-relaxed", dark ? "text-white/80" : "text-muted"]}>{description}</p>
      <slot />
    </div>
    <div class="flex flex-col gap-3 sm:flex-row sm:flex-wrap lg:max-w-[560px] lg:justify-end">
      {
        companyInfo.phones.map((phone) => (
          <a
            href={phone.href}
            class:list={[
              "btn whitespace-nowrap",
              dark ? "border border-white/30 text-white hover:bg-white hover:text-navy-deep" : "border border-line bg-white text-navy-deep hover:border-bordo hover:text-bordo",
            ]}
          >
            <Icon name="phone" size={17} />
            {phone.display}
          </a>
        ))
      }
      <a href={mailto} class="btn-primary whitespace-nowrap">
        <Icon name="mail" size={17} />
        {companyInfo.email}
      </a>
    </div>
  </div>
</section>
