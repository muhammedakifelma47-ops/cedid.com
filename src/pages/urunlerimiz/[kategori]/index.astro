---
import { Image } from "astro:assets";
import type { GetStaticPaths } from "astro";
import SiteLayout from "../../../layouts/SiteLayout.astro";
import PageHero from "../../../components/PageHero.astro";
import CategoryNavigation from "../../../components/CategoryNavigation.astro";
import ProductCard from "../../../components/ProductCard.astro";
import Icon from "../../../components/Icon.astro";
import { categories, getProductsByCategory, getProductsByGroup, type Category } from "../../../data/catalog";
import { getCategoryImage, getGroupImage } from "../../../lib/images";

export const getStaticPaths = (() =>
  categories.map((category) => ({ params: { kategori: category.slug }, props: { category } }))) satisfies GetStaticPaths;

interface Props {
  category: Category;
}

const { category } = Astro.props;
const total = getProductsByCategory(category.slug).length;
const groups = category.groups
  .map((group) => ({ ...group, products: getProductsByGroup(category.slug, group.slug) }))
  .filter((group) => group.products.length > 0);

const contactNote =
  category.slug === "gida"
    ? "Çay, kahve ve şeker ürünleri hakkında bilgi almak için bizimle iletişime geçin."
    : `Diğer ${category.name.toLocaleLowerCase("tr-TR")} hakkında bilgi almak için bizimle iletişime geçin.`;
---

<SiteLayout title={category.seoTitle} description={category.seoDescription} image={getCategoryImage(category.slug)}>
  <PageHero
    eyebrow="Ürünlerimiz"
    title={category.name}
    description={category.description}
    image={getCategoryImage(category.slug)}
    imageAlt={`${category.name} (temsili görsel)`}
    breadcrumbs={[{ label: "Ürünlerimiz", href: "/urunlerimiz" }, { label: category.name }]}
    tone={category.accent}
  />

  <div class="container-site grid gap-8 py-10 lg:grid-cols-[290px_minmax(0,1fr)] lg:gap-10 lg:py-14">
    <CategoryNavigation active={category.slug} />

    <div class="min-w-0">
      <div class="flex flex-col gap-4 border-b border-line pb-6">
        <p class="text-[15px] text-muted">
          <strong class="font-bold text-navy-deep">{total} ürün grubu</strong>, {groups.length} başlık altında listelenmektedir.
        </p>
        <nav aria-label="Alt gruplar">
          <ul class="flex flex-wrap gap-2">
            {
              groups.map((group) => (
                <li>
                  <a
                    href={`#${group.slug}`}
                    class="inline-flex items-center gap-1.5 rounded-full border border-line bg-white px-3.5 py-2 text-[13.5px] font-medium text-navy-deep transition-colors hover:border-bordo hover:text-bordo"
                  >
                    {group.name}
                    <span class="text-muted">({group.products.length})</span>
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
      </div>

      {
        category.layout === "grid" &&
          groups.map((group) => (
            <section id={group.slug} class="scroll-mt-32 pt-10" aria-labelledby={`baslik-${group.slug}`}>
              <div class="mb-5 flex flex-col gap-1">
                <h2 id={`baslik-${group.slug}`} class="text-[22px] font-bold lg:text-[24px]">
                  {group.name}
                </h2>
                <p class="text-[14.5px] text-muted">{group.description}</p>
              </div>
              <ul class="grid gap-5 sm:grid-cols-2 xl:grid-cols-3">
                {group.products.map((product) => (
                  <li>
                    <ProductCard product={product} />
                  </li>
                ))}
              </ul>
            </section>
          ))
      }

      {
        category.layout === "list" &&
          groups.map((group) => (
            <section id={group.slug} class="scroll-mt-32 pt-10" aria-labelledby={`baslik-${group.slug}`}>
              <div class="mb-5 flex items-end justify-between gap-4 border-l-[3px] border-bordo pl-4">
                <div>
                  <h2 id={`baslik-${group.slug}`} class="text-[22px] font-bold lg:text-[24px]">
                    {group.name}
                  </h2>
                  <p class="mt-1 text-[14.5px] text-muted">{group.description}</p>
                </div>
              </div>
              <ul class="grid gap-4 md:grid-cols-2">
                {group.products.map((product) => (
                  <li>
                    <ProductCard product={product} variant="list" />
                  </li>
                ))}
              </ul>
            </section>
          ))
      }

      {
        category.layout === "groups" &&
          groups.map((group, index) => {
            const groupImage = getGroupImage(group.slug);
            return (
              <section id={group.slug} class="scroll-mt-32 pt-10" aria-labelledby={`baslik-${group.slug}`}>
                <div class="grid overflow-hidden rounded-md md:grid-cols-2">
                  {groupImage && (
                    <div class:list={["relative min-h-[220px] bg-light", index % 2 === 1 && "md:order-2"]}>
                      <Image
                        src={groupImage}
                        alt={`${group.name} (temsili görsel)`}
                        widths={[480, 720, 960]}
                        sizes="(min-width: 768px) 40vw, 100vw"
                        class="absolute inset-0 h-full w-full object-cover"
                      />
                    </div>
                  )}
                  <div class:list={["flex flex-col justify-center p-7 text-white lg:p-9", index % 2 === 1 ? "bg-bordo" : "bg-navy-deep"]}>
                    <p class="text-[13px] font-bold uppercase tracking-[0.1em] text-white/75">Gıda Ürünleri</p>
                    <h2 id={`baslik-${group.slug}`} class="mt-2 text-[30px] font-bold text-white">
                      {group.name}
                    </h2>
                    <p class="mt-3 text-[15px] leading-relaxed text-white/85">{group.description}</p>
                    <p class="mt-4 text-[14px] text-white/75">{group.products.length} ürün türü</p>
                  </div>
                </div>
                <ul class="mt-5 grid gap-5 sm:grid-cols-2 xl:grid-cols-3">
                  {group.products.map((product) => (
                    <li>
                      <ProductCard product={product} groupLabel={group.name} />
                    </li>
                  ))}
                </ul>
              </section>
            );
          })
      }

      <p class="mt-10 flex items-start gap-2 text-[13.5px] text-muted">
        <Icon name="info" size={16} class="mt-0.5 shrink-0 text-navy" />
        Görseller ürün gruplarını temsil eder. Marka, ölçü, ambalaj ve tedarik durumu bilgileri için bizimle iletişime geçin.
      </p>

      <div class="mt-8 flex flex-col gap-5 rounded-md border border-line bg-light p-6 sm:flex-row sm:items-center sm:justify-between lg:p-8">
        <p class="max-w-[560px] text-[16px] font-medium leading-relaxed text-navy-deep">{contactNote}</p>
        <a href="/iletisim" class="btn-primary shrink-0">
          İletişim
          <Icon name="arrow-right" size={17} />
        </a>
      </div>
    </div>
  </div>
</SiteLayout>
